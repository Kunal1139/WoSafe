<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WoSafe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/bgmain</item>
        <item name="colorPrimaryVariant">@color/bgmain</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Set the status bar color to bgmain -->
        <item name="android:statusBarColor">@color/bgmain</item> <!-- Change made here -->
        <!-- Set the navigation bar color to match the action bar (optional) -->
        <item name="android:navigationBarColor">@color/bgmain</item>
    </style>

    <style name="Theme.WoSafe" parent="Base.Theme.WoSafe" />
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in</item>
        <item name="android:windowExitAnimation">@anim/slide_out</item>
    </style>
</resources>
